---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/sections/Footer.astro';
import Hero from '../../components/sections/Hero.astro';
import Skills from '../../components/sections/Skills.astro';
import Experience from '../../components/sections/Experience.astro';
import Projects from '../../components/sections/Projects.astro';
import Videos from '../../components/sections/Videos.astro';
import Connect from '../../components/sections/Connect.astro';
import { getWebConfig } from '../../lib/data';

const webConfig = getWebConfig();
const lang = 'en' as const;
---

<BaseLayout
  title={webConfig.site.title}
  description={webConfig.site.description}
  lang={lang}
  alternates={{ id: 'https://indrawan.dev/', en: 'https://indrawan.dev/en/' }}
>
  <Header lang={lang} alternateUrl="/" />
  <Hero lang={lang} />
  <Skills lang={lang} />
  <Experience lang={lang} />
  <Projects lang={lang} />
  <Videos lang={lang} />
  <Connect lang={lang} />
  <Footer />
</BaseLayout>
