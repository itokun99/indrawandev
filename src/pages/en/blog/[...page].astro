---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PostCard from '../../components/blog/PostCard.astro';
import { getWebConfig } from '../../lib/data';
import { postsFor } from '../../lib/posts';
import { t } from '../../lib/i18n';
import { paginate } from 'astro:pagination';

const webConfig = getWebConfig();
const lang = 'en' as const;

const posts = await postsFor(lang);

export async function getStaticPaths() {
  return paginate(posts, { pageSize: 10 }).map(({ page }) => ({
    params: {},
    props: { page },
  }));
}

const { page } = Astro.props;
---

<BaseLayout
  title={`${t(lang, 'blog.title')} - ${webConfig.site.title}`}
  description={t(lang, 'blog.sampleNote')}
  lang={lang}
  alternates={{ id: '/blog/', en: '/en/blog/' }}
>
  <Header lang={lang} alternateUrl="/blog/" />
  <main class="py-16 md:py-24">
    <div class="container">
      <h1 class="text-3xl font-bold tracking-tight mb-8">
        {t(lang, 'blog.title')}
      </h1>
      <div class="space-y-6" data-post-count={page.data.length}>
        {page.data.map((entry) => (
          <PostCard entry={entry} lang={lang} />
        ))}
      </div>
      {page.data.length === 0 && (
        <p class="text-muted-foreground">{t(lang, 'blog.empty')}</p>
      )}
      {page.url.pathname !== '/en/blog/' && (
        <meta name="robots" content="noindex,follow" />
      )}
      <nav class="flex justify-center gap-4 mt-8">
        {page.url.prev && (
          <a
            href={page.url.prev}
            class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
          >
            {t(lang, 'blog.prev')}
          </a>
        )}
        {page.url.next && (
          <a
            href={page.url.next}
            class="inline-flex items-center justify-center rounded-md text-sm font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-input bg-background hover:bg-accent hover:text-accent-foreground h-10 px-4 py-2"
          >
            {t(lang, 'blog.next')}
          </a>
        )}
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>
