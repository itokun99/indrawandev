---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import PostCard from '../../../components/blog/PostCard.astro';
import { getWebConfig } from '../../../lib/data';
import { postsFor } from '../../../lib/posts';
import { t } from '../../../lib/i18n';

const webConfig = getWebConfig();
const lang = 'en' as const;

const posts = await postsFor(lang);
---

<BaseLayout
  title={`${t(lang, 'blog.title')} - ${webConfig.site.title}`}
  description={t(lang, 'blog.sampleNote')}
  lang={lang}
  alternates={{ id: '/blog/', en: '/en/blog/' }}
>
  <Header lang={lang} alternateUrl="/blog/" />
  <main class="py-16 md:py-24">
    <div class="container">
      <h1 class="text-3xl font-bold tracking-tight mb-8">
        {t(lang, 'blog.title')}
      </h1>
      <div class="space-y-6">
        {posts.map((entry) => (
          <PostCard entry={entry} lang={lang} />
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
