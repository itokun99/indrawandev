---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getWebConfig } from '../../lib/data';
import { postsFor, slugOf } from '../../lib/posts';
import { formatDate, toIsoUtc } from '../../lib/dates';
import { t } from '../../lib/i18n';

const lang = 'en' as const;
const posts = await postsFor(lang);

export async function getStaticPaths() {
  return posts.map((entry) => ({
    params: { slug: slugOf(entry) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const prev = posts[posts.indexOf(entry) + 1] ?? null;
const next = posts[posts.indexOf(entry) - 1] ?? null;

const translations = posts.filter(p => p.data.translationKey === entry.data.translationKey && p.id !== entry.id);
const altLang = translations[0]?.id.startsWith('id/') ? 'id' : null;

const webConfig = getWebConfig();
---

<BaseLayout
  title={`${entry.data.title} - ${webConfig.site.title}`}
  description={entry.data.description}
  lang={lang}
  ogType="article"
  alternates={altLang ? {
    id: altLang === 'id' ? `/blog/${slugOf(entry)}/` : `/en/blog/${slugOf(entry)}/`,
    en: lang === 'en' ? `/blog/${slugOf(entry)}/` : `/en/blog/${slugOf(entry)}/`
  } : undefined}
  extraLd={[
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      headline: entry.data.title,
      description: entry.data.description,
      datePublished: toIsoUtc(entry.data.pubDate),
      dateModified: entry.data.updatedDate ? toIsoUtc(entry.data.updatedDate) : toIsoUtc(entry.data.pubDate),
      author: {
        "@type": "Person",
        name: webConfig.site.author,
        url: webConfig.site.url
      },
      mainEntityOfPage: {
        "@type": "WebPage",
        "@id": Astro.url.href
      },
      inLanguage: lang
    },
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: webConfig.site.url },
        { "@type": "ListItem", position: 2, name: "Blog", item: `${webConfig.site.url}/en/blog/` },
        { "@type": "ListItem", position: 3, name: entry.data.title }
      ]
    }
  ]}
>
  <Header lang={lang} alternateUrl="/blog/" />
  <main class="py-16 md:py-24">
    <div class="container max-w-3xl">
      <a href="/en/blog/" class="text-sm text-muted-foreground hover:text-foreground inline-flex items-center gap-1 mb-6">
        ← {t(lang, 'blog.backToList')}
      </a>
      <article class="prose prose-slate dark:prose-invert max-w-none">
        <h1>{entry.data.title}</h1>
        <div class="flex items-center gap-4 text-sm text-muted-foreground mb-6">
          <time datetime={toIsoUtc(entry.data.pubDate)}>
            {t(lang, 'blog.published')} {formatDate(entry.data.pubDate, lang)}
          </time>
          {entry.data.updatedDate && (
            <span>
              {t(lang, 'blog.updated')} {formatDate(entry.data.updatedDate, lang)}
            </span>
          )}
        </div>
        {render(entry).body}
        {entry.data.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-6">
            {entry.data.tags.map((tag) => (
              <a
                href={`/en/blog/tags/${tag}`}
                class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80"
              >
                #{tag}
              </a>
            ))}
          </div>
        )}
      </article>
      <nav class="flex justify-between mt-12 pt-8 border-t">
        {prev ? (
          <a href={`/en/blog/${slugOf(prev)}/`} class="text-sm text-muted-foreground hover:text-foreground">
            ← {prev.data.title}
          </a>
        ) : <span />}
        {next ? (
          <a href={`/en/blog/${slugOf(next)}/`} class="text-sm text-muted-foreground hover:text-foreground">
            {next.data.title} →
          </a>
        ) : <span />}
      </nav>
    </div>
  </main>
  <Footer />
</BaseLayout>
