---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import { getWebConfig } from '../../../lib/data';
import { postsFor } from '../../../lib/posts';
import { t } from '../../../lib/i18n';

const lang = 'id' as const;

export async function getStaticPaths() {
  const posts = await postsFor('id');
  const allTags = [...new Set(posts.flatMap(p => p.data.tags))];
  return allTags.map((tag) => ({
    params: { tag },
    props: { tag, posts },
  }));
}

const { tag, posts } = Astro.props;

const tagPosts = posts.filter(p => p.data.tags.includes(tag as string));
const webConfig = getWebConfig();
---

<BaseLayout
  title={`#${tag} - ${t(lang, 'blog.title')}`}
  description={`Posts tagged ${tag}`}
  lang={lang}
>
  <Header lang={lang} alternateUrl={`/en/blog/tags/${tag}/`} />
  <main class="py-16 md:py-24">
    <div class="container max-w-3xl">
      <a href="/blog/" class="text-sm text-muted-foreground hover:text-foreground inline-flex items-center gap-1 mb-6">
        ← {t(lang, 'blog.backToList')}
      </a>
      <h1 class="text-3xl font-bold tracking-tight mb-8">#{tag}</h1>
      <div class="space-y-6">
        {tagPosts.map((entry) => (
          <article class="rounded-lg border bg-card text-card-foreground shadow-sm">
            <div class="p-6">
              <h3 class="font-semibold text-lg">
                <a href={`/blog/${entry.data.slug ?? entry.slug}/`}>{entry.data.title}</a>
              </h3>
              <p class="text-sm text-muted-foreground mt-2">{entry.data.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>
