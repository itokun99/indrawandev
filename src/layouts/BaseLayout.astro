---
interface Props {
  title: string;
  description: string;
  lang: Lang;
  canonicalPath?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  alternates?: { id: string; en: string };
  extraLd?: object[];
}

const {
  title,
  description,
  lang,
  canonicalPath,
  ogType = 'website',
  ogImage,
  alternates,
  extraLd = []
} = Astro.props;

import type { Lang } from '../lib/i18n';
import { Font } from 'astro:assets';
import '../styles/global.css';

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site);
---

<!DOCTYPE html>
<html lang={lang} class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.toString()} />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.toString()} />
    <meta property="og:site_name" content="indrawan.dev" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:creator" content="@indrawandev" />
    <meta name="theme-color" content="#050505" />
    <link rel="icon" href="/icon.svg" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    {alternates && (
      <>
        <link rel="alternate" hreflang="id" href={alternates.id} />
        <link rel="alternate" hreflang="en" href={alternates.en} />
        <link rel="alternate" hreflang="x-default" href={alternates.id} />
      </>
    )}
    {extraLd.length > 0 && extraLd.map((ld: object) => (
      <script type="application/ld+json">{JSON.stringify(ld)}</script>
    ))}
    <script is:inline>
      (function() {
        const theme = localStorage.getItem('theme');
        if (theme === 'light') {
          document.documentElement.classList.remove('dark');
        } else if (!theme && matchMedia('(prefers-color-scheme: light)').matches) {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-black focus:text-white">Skip to main content</a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
