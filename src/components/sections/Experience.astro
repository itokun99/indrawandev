---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import { getWorkExperience } from '../../lib/data';

const { lang } = Astro.props;
const experiences = getWorkExperience();
---

<section id="experience" class="py-16 md:py-24">
  <div class="container">
    <h2 class="text-3xl font-bold tracking-tight mb-8">
      {t(lang, 'experience.title')}
    </h2>
    <div class="space-y-8">
      {experiences.map((exp) => (
        <div class="rounded-lg border bg-card text-card-foreground shadow-sm">
          <div class="p-6">
            <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
              <div>
                <h3 class="font-semibold leading-none tracking-tight">
                  {exp.title}
                </h3>
                <p class="text-sm text-muted-foreground mt-1">
                  {exp.company} · {exp.location}
                </p>
                <p class="text-sm text-muted-foreground">
                  {exp.period}
                </p>
              </div>
              <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold whitespace-nowrap border-transparent bg-secondary text-secondary-foreground hover:bg-secondary/80">
                {exp.type}
              </span>
            </div>
            <p class="mt-4 text-sm">
              {exp.description}
            </p>
            <div class="mt-4">
              <p class="text-sm font-medium mb-2">{t(lang, 'experience.tech')}:</p>
              <div class="flex flex-wrap gap-2">
                {exp.technologies.slice(0, 5).map((tech) => (
                  <span class="inline-flex items-center rounded-md border px-2.5 py-0.5 text-xs font-semibold border-transparent bg-secondary text-secondary-foreground">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
            <div class="mt-4">
              <ul class="list-disc list-inside text-sm space-y-1">
                {exp.achievements.slice(0, 3).map((achievement) => (
                  <li>{achievement}</li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
