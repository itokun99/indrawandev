---
import type { Lang } from '../../lib/i18n';
import { t } from '../../lib/i18n';
import { getYouTubeVideos } from '../../lib/data';

const { lang } = Astro.props;
const videos = getYouTubeVideos();
---

<section id="videos" class="py-16 md:py-24">
  <div class="container">
    <h2 class="text-3xl font-bold tracking-tight mb-8">
      {t(lang, 'videos.title')}
    </h2>
    <div class="grid gap-6 md:grid-cols-2">
      {videos.map((video) => (
        <a
          href={`https://www.youtube.com/watch?v=${video.videoId}`}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border bg-card text-card-foreground shadow-sm overflow-hidden transition-shadow hover:shadow-md"
        >
          <div class="aspect-video bg-muted flex items-center justify-center">
            <svg class="h-12 w-12 text-muted-foreground" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="5 3 19 12 5 21 5 3"/></svg>
          </div>
          <div class="p-4">
            <p class="text-sm font-medium">{video.title}</p>
            <p class="text-sm text-muted-foreground mt-1">{video.category}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>
